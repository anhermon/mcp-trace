#!/usr/bin/env bash
# pre-commit hook — runs task ci (vet + test + lint + build) before every commit.
# Install with: task hooks:install
#
# To bypass in emergencies only: git commit --no-verify

set -euo pipefail

# Require task to be installed.
if ! command -v task &>/dev/null; then
  echo "pre-commit: 'task' not found — install from https://taskfile.dev and re-run task hooks:install"
  exit 1
fi

echo "pre-commit: running task ci …"

# Run the full CI pipeline. Output is shown inline so failures are visible.
if ! task ci; then
  echo ""
  echo "pre-commit: ✗ task ci failed — commit blocked."
  echo "  Fix the issues above, then re-commit."
  echo "  (emergency bypass: git commit --no-verify)"
  exit 1
fi

echo "pre-commit: ✓ all checks passed"
